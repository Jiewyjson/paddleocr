# Leave empty so the browser calls same-origin /api/ocr (Vite proxy locally,
# Pages Function in production). Only set this for a direct local FastAPI URL.
# PUBLIC_OCR_ENDPOINT=http://127.0.0.1:8788/v1/ocr

# Server-side Vite proxy target. Match OCR_BIND_HOST / the LAN API address.
OCR_API_ORIGIN=http://127.0.0.1:8788
