# Development on one Mac: keep FastAPI loopback-only.
# When cloudflared runs on a different LAN machine, replace this with the OCR
# Mac's reserved LAN address (for example 192.168.1.50), not 0.0.0.0. Restrict
# TCP/8788 with the Mac/router firewall so only the tunnel host can reach it.
OCR_BIND_HOST=127.0.0.1
OCR_PORT=8788

# Direct browser development only. Production traffic uses the same-origin Pages Function.
OCR_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Crop-only limits. The frontend also downscales its JPEG before sending it.
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_IMAGE_PIXELS=16000000
OCR_MIN_CROP_EDGE=24

# Strategy: fast, balanced, accurate, document. Retain VL until local comparison.
OCR_DEFAULT_STRATEGY=document
# Maximum API-side pipeline instances; MLX weights are managed separately.
OCR_STRATEGY_CACHE_SIZE=2

# The existing local PaddleOCR-VL + MLX-VLM setup.
OCR_PIPELINE_VERSION=v1.5
OCR_VL_BACKEND=mlx-vlm-server
OCR_VL_SERVER_URL=http://127.0.0.1:8111/
# Use the locally installed MLX-compatible PaddleOCR-VL directory, not the
# Hugging Face repository name. Settings expands a leading ~ before use.
OCR_VL_API_MODEL_NAME=~/.paddlex/official_models/PaddleOCR-VL-1.5
OCR_DEVICE=cpu
OCR_USE_LAYOUT_DETECTION=false

# Leave blank to retain model defaults. Do not set this below the output a selected zone needs.
OCR_MAX_NEW_TOKENS=
